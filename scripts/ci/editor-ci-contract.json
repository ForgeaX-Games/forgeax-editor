{
  "$schema": "forgeax-editor-ci-contract/v1",
  "version": "forgeax-editor-ci-contract/v1",
  "checks": [
    {
      "checkId": "b2-self-boot",
      "owner": "editor-ci",
      "command": "bun scripts/selfcheck-standalone-b2.mjs",
      "executionHome": {
        "local-fast": true,
        "local-full": true,
        "PR": true,
        "main": true,
        "nightly/scheduled": true,
        "post-merge": true
      },
      "failureClasses": ["admission", "environment", "source", "external-transport"]
    },
    {
      "checkId": "typecheck",
      "owner": "editor-ci",
      "command": "bun run typecheck",
      "executionHome": {
        "local-fast": true,
        "local-full": true,
        "PR": true,
        "main": true,
        "nightly/scheduled": true,
        "post-merge": true
      },
      "failureClasses": ["admission", "environment", "source", "external-transport"]
    },
    {
      "checkId": "r0-hierarchy-ui-editability",
      "owner": "editor-ci",
      "command": "bun -F @forgeax/editor-panels test src/__tests__/hierarchy-runtime-access.test.ts",
      "executionHome": {
        "local-fast": true,
        "local-full": true,
        "PR": false,
        "main": false,
        "nightly/scheduled": false,
        "post-merge": false
      },
      "failureClasses": ["admission", "environment", "source", "external-transport"]
    },
    {
      "checkId": "r0-sample-vfx-skill",
      "owner": "editor-ci",
      "command": "bun scripts/lint-sample-vfx-skill.mjs",
      "executionHome": {
        "local-fast": true,
        "local-full": true,
        "PR": false,
        "main": false,
        "nightly/scheduled": false,
        "post-merge": false
      },
      "failureClasses": ["admission", "environment", "source", "external-transport"]
    },
    {
      "checkId": "r0-engine-dogfood-diagnostics",
      "owner": "editor-ci",
      "command": "pnpm -C packages/engine exec vitest run --project=@forgeax/engine-animation packages/animation/src/__tests__/animation-diagnostic.unit.test.ts --project=@forgeax/engine-vite-plugin-rhi-debug packages/vite-plugin-rhi-debug/src/__tests__/trigger.test.ts",
      "executionHome": {
        "local-fast": true,
        "local-full": true,
        "PR": false,
        "main": false,
        "nightly/scheduled": false,
        "post-merge": false
      },
      "failureClasses": ["admission", "environment", "source", "external-transport"]
    },
    {
      "checkId": "submodule-pin",
      "owner": "editor-ci",
      "command": "node scripts/check-submodule-pins.mjs",
      "executionHome": {
        "local-fast": false,
        "local-full": true,
        "PR": true,
        "main": true,
        "nightly/scheduled": true,
        "post-merge": true
      },
      "failureClasses": ["admission", "environment", "source", "external-transport"]
    },
    {
      "checkId": "smoke-play",
      "owner": "editor-ci",
      "command": "bun run test:e2e -- apps/standalone/e2e/__tests__/smoke-boot-play.spec.ts apps/standalone/e2e/__tests__/hierarchy-ui-layout.spec.ts",
      "executionHome": {
        "local-fast": false,
        "local-full": true,
        "PR": true,
        "main": true,
        "nightly/scheduled": true,
        "post-merge": true
      },
      "failureClasses": ["admission", "environment", "source", "external-transport"]
    }
  ],
  "profiles": {
    "local-fast": ["b2-self-boot", "typecheck", "r0-hierarchy-ui-editability", "r0-sample-vfx-skill", "r0-engine-dogfood-diagnostics"],
    "local-full": ["b2-self-boot", "typecheck", "r0-hierarchy-ui-editability", "r0-sample-vfx-skill", "r0-engine-dogfood-diagnostics", "submodule-pin", "smoke-play"],
    "PR": ["b2-self-boot", "typecheck", "submodule-pin", "smoke-play"],
    "main": ["b2-self-boot", "typecheck", "submodule-pin", "smoke-play"],
    "nightly/scheduled": ["b2-self-boot", "typecheck", "submodule-pin", "smoke-play"],
    "post-merge": ["b2-self-boot", "typecheck", "submodule-pin", "smoke-play"]
  },
  "requiredContexts": [
    {"context": "b2-self-boot", "checkId": "b2-self-boot"},
    {"context": "typecheck", "checkId": "typecheck"},
    {"context": "submodule-pin", "checkId": "submodule-pin"},
    {"context": "smoke-play", "checkId": "smoke-play"}
  ],
  "packageQuality": {
    "ownershipClasses": [
      "Editor-owned",
      "consumed-submodule-contract",
      "intentionally non-tested host"
    ],
    "coveragePolicy": {
      "requiredDimensions": ["lines", "functions"],
      "range": [0, 100],
      "source": "package-producer"
    }
  },
  "provenance": {
    "local": {"kind": "local", "timingDomain": "local-execution"},
    "cloud": {"kind": "cloud", "timingDomain": "workflow-execution"},
    "post-merge": {"kind": "cloud", "timingDomain": "workflow-execution"}
  },
  "failurePolicy": {
    "failureClasses": ["admission", "environment", "source", "external-transport"],
    "retryableClass": "external-transport",
    "requiresTransientEvidence": true,
    "maxAutomaticRetries": 1,
    "sloClaim": null
  },
  "delivery": {
    "verifier": {
      "entrypoint": "scripts/ci/editor-ci-contract.mjs",
      "command": "bun run ci:delivery"
    },
    "requiredContextsRef": "requiredContexts",
    "measurementRequired": false,
    "sourceRepository": "editor",
    "harnessRepository": "floating-harness"
  },
  "prerequisiteRelease": {
    "schemaVersion": "forgeax-prerequisite-release/v1",
    "owner": "editor-ci",
    "producer": "prerequisite-release",
    "payloadClasses": {
      "engine-dist": {"paths": ["payload/engine-dist"], "optional": false},
      "wgpu-wasm": {"paths": ["payload/wgpu-wasm"], "optional": false},
      "fbx-wasm": {"paths": ["payload/fbx-wasm"], "optional": true},
      "bun-install-facts": {"paths": ["payload/bun-install-facts"], "optional": false},
      "editor-generated-inputs": {"paths": [], "optional": true}
    },
    "consumers": {
      "b2-self-boot": ["engine-dist", "wgpu-wasm", "bun-install-facts"],
      "typecheck": ["engine-dist", "wgpu-wasm", "bun-install-facts"],
      "smoke-play": ["engine-dist", "wgpu-wasm", "fbx-wasm", "bun-install-facts"],
      "submodule-pin": []
    },
    "activeProfiles": {
      "PR": ["b2-self-boot", "typecheck", "submodule-pin", "smoke-play"],
      "main": ["b2-self-boot", "typecheck", "submodule-pin", "smoke-play"],
      "nightly/scheduled": ["b2-self-boot", "typecheck", "submodule-pin", "smoke-play"],
      "post-merge": ["b2-self-boot", "typecheck", "submodule-pin", "smoke-play"]
    },
    "identity": {
      "fields": ["artifactId", "releaseDigest", "schemaVersion", "inventory", "producerRunId", "producerAttempt", "sourceSha", "recursivePins", "producerSuccess"]
    },
    "manifest": {
      "requiredFields": ["schemaVersion", "artifactId", "releaseDigest", "inventory", "producerRunId", "producerAttempt", "sourceSha", "recursivePins", "producerSuccess", "producerEnvironmentFingerprint", "compatibility"],
      "digestAlgorithm": "sha256",
      "inventoryFields": ["payloadClass", "path", "sha256"]
    },
    "compatibility": {
      "fields": ["os", "architecture", "bunVersion", "nodeVersion", "pnpmVersion", "rustVersion", "wasmPackVersion", "capacityPool"],
      "rules": {
        "os": ["linux"],
        "architecture": ["x64"],
        "capacityPool": ["standard", "heavy"]
      }
    }
  },
  "browserReleasePortfolio": {
    "schemaVersion": "forgeax-browser-release-portfolio/v1",
    "owner": "editor-ci",
    "parentCheckId": "smoke-play",
    "requiredContextsRef": "requiredContexts",
    "measurement": {
      "required": false,
      "phase": "pre-topology",
      "indexStatus": null
    },
    "evidence": {
      "schemaVersion": "forgeax-browser-release-evidence/v1",
      "requiredFields": [
        "sourceSha",
        "contractDigest",
        "admissionGeneration",
        "terminalStatus",
        "expected",
        "observed"
      ],
      "failureFields": ["code", "hint", "expected", "observed"]
    },
    "discovery": {
      "roots": ["apps/standalone/e2e", "scripts", "package.json", ".github/workflows"],
      "ownedSources": [
        "apps/standalone/e2e/__tests__/smoke-boot-play.spec.ts",
        "apps/standalone/e2e/__tests__/editor-browser-smoke.spec.ts",
        "apps/standalone/e2e/__tests__/create-game-browser-smoke.spec.ts",
        "scripts/repro-default-scene-import-404.mjs",
        "apps/standalone/e2e/__tests__/j4-runner.spec.ts",
        "scripts/static-build-smoke.mjs"
      ],
      "unmatchedDisposition": "structured-exclusion",
      "exclusionClass": "not-release-owned",
      "exclusionOwner": "editor-ci"
    },
    "profiles": {
      "browser-journey": {
        "kind": "playwright",
        "requiredUnitFields": ["unitId", "source", "parentCheckId", "owner", "profile", "evidence"]
      },
      "release-script": {
        "kind": "script",
        "requiredUnitFields": ["unitId", "source", "parentCheckId", "owner", "profile", "evidence"]
      }
    }
  }
}
