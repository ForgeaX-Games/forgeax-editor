{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["packages/edit-runtime/src/public/**/*.ts", "scripts/types/forgeax-engine-shims.d.ts"],
  "exclude": ["packages/edit-runtime/src/public/**/*.test.ts", "packages/edit-runtime/src/public/**/*.test.tsx"]
}
