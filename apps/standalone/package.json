{
  "name": "@forgeax/editor-standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private standalone Editor application; composes Editor with Interface in this repository.",
  "scripts": {
    "dev": "bun ../../scripts/dev-standalone.ts",
    "dev:host": "vite --config ../../vite.config.ts",
    "build": "vite build --config ../../vite.config.ts",
    "test": "bun test ./__tests__ --path-ignore-patterns=**/repro-console.test.mjs"
  },
  "forgeaxCi": {
    "ownership": "Editor-owned",
    "quality": {
      "test": "bun test ./__tests__ --path-ignore-patterns=**/repro-console.test.mjs",
      "coverage": { "lines": 100, "functions": 84.62 }
    }
  },
  "dependencies": {
    "@forgeax/app-shell": "0.103.0",
    "@forgeax/editor": "file:../..",
    "@forgeax/editor-content-browser": "workspace:*",
    "@forgeax/editor-core": "workspace:*",
    "@forgeax/editor-edit-runtime": "workspace:*",
    "@forgeax/editor-ui": "workspace:*",
    "@forgeax/engine-devkit": "workspace:*",
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/engine-tool-runtime": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/interface": "0.9.5",
    "@forgeax/platform-io": "workspace:*",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@playwright/test": "^1.45.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
