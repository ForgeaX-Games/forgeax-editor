{
  "$ref": "#/definitions/NpcSessionResponse",
  "definitions": {
    "NpcSessionResponse": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            },
            "token": {
              "type": "string",
              "minLength": 16,
              "maxLength": 512
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "loaded": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "npcId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                  },
                  "soulId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                  },
                  "trustTier": {
                    "type": "string",
                    "enum": [
                      "own",
                      "imported"
                    ]
                  },
                  "decisionTimeoutMs": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 30000
                  }
                },
                "required": [
                  "npcId",
                  "soulId",
                  "trustTier",
                  "decisionTimeoutMs"
                ],
                "additionalProperties": false
              },
              "maxItems": 128
            },
            "wsUrl": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "ok",
            "sessionId",
            "token",
            "epoch",
            "expiresAt",
            "loaded",
            "wsUrl"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "error": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
