{
  "type": "object",
  "properties": {
    "game": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "npcId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "soulId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "decisionDeadline": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "fast"
            }
          },
          "required": [
            "preset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "balanced"
            }
          },
          "required": [
            "preset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "patient"
            }
          },
          "required": [
            "preset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "custom"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 30000
            }
          },
          "required": [
            "preset",
            "timeoutMs"
          ],
          "additionalProperties": false
        }
      ]
    },
    "affordances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "enum"
                    },
                    "source": {
                      "type": "string",
                      "const": "waypoint"
                    }
                  },
                  "required": [
                    "type",
                    "source"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "enum"
                    },
                    "source": {
                      "type": "string",
                      "const": "nearby.id"
                    }
                  },
                  "required": [
                    "type",
                    "source"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "enum"
                    },
                    "source": {
                      "type": "string",
                      "const": "literal"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "minItems": 1,
                      "maxItems": 32
                    }
                  },
                  "required": [
                    "type",
                    "source",
                    "values"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "propertyNames": {
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            }
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "game",
    "npcId",
    "soulId",
    "affordances"
  ],
  "additionalProperties": false
}
