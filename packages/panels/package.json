{
  "name": "@forgeax/editor-panels",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "forgeax editor business panels (Hierarchy, Inspector, Assets, History, Capabilities, Launcher, asset Overview/Properties, mesh Material Slots) + panel manifest SSOT. The Assets panel lazy-loads @forgeax/editor-content-browser.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./panels": {
      "types": "./src/manifest.ts",
      "import": "./src/manifest.ts"
    },
    "./hierarchy-projection": {
      "types": "./src/hierarchy-projection.ts",
      "import": "./src/hierarchy-projection.ts"
    },
    "./inspector-runtime-projection": {
      "types": "./src/inspector-runtime-projection.ts",
      "import": "./src/inspector-runtime-projection.ts"
    },
    "./diagnostics-projection": {
      "types": "./src/diagnostics-projection.ts",
      "import": "./src/diagnostics-projection.ts"
    },
    "./operation-projection": {
      "types": "./src/operation-projection.ts",
      "import": "./src/operation-projection.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "bun test"
  },
  "forgeaxCi": {
    "ownership": "Editor-owned",
    "quality": {
      "test": "bun test",
      "coverage": {"lines": 27.64, "functions": 20.77}
    }
  },
  "dependencies": {
    "@forgeax/editor-core": "workspace:*",
    "@forgeax/editor-content-browser": "workspace:*",
    "@forgeax/editor-ui": "workspace:*",
    "@forgeax/interface": "workspace:*",
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-animation": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-profiler": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-vfx": "workspace:*",
    "@tanstack/react-virtual": "^3.14.3",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@types/bun": "^1.3.13",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
